DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_PUBLIC_DEMO=True
DJANGO_ALLOWED_HOSTS=your-app.example.com,your-hosting-url.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com,https://your-hosting-url.example
DJANGO_SECURE_COOKIES=True
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSLMODE=require
