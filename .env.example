DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_PUBLIC_DEMO=False
DJANGO_ALLOWED_HOSTS=your-app.example.com,your-hosting-url.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com,https://your-hosting-url.example
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_PROXY_SSL_HEADER=True
DJANGO_ENABLE_ADMIN=False
DJANGO_SERVE_MEDIA=False
DJANGO_ALLOW_DEVTUNNELS=False
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
